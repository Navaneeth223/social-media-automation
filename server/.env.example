# MongoDB — Atlas M0 (free) or a local instance.
# Atlas: create an M0 cluster → database user → allow your IP → paste the string.
MONGODB_URI=mongodb://127.0.0.1:27017/pulse

# Generate once:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Server refuses to boot without it — never commit the real value.
JWT_SECRET=replace-me

# Generate once:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production — encrypts platform tokens at rest (AES-256-GCM).
ENCRYPTION_KEY=

# Local API port
PORT=8787

# Frontend origin allowed to call the API with cookies (no trailing slash).
CLIENT_ORIGIN=http://localhost:5173

# ——— Phase 5: TikTok ———
# developers.tiktok.com → Manage apps → add products:
#   "Login Kit" + "Content Posting API" → redirect URI:
#   http://localhost:8787/api/auth/tiktok/callback
# Until the app passes TikTok's audit, posts are FORCED to SELF_ONLY
# (private to the uploader). Flip via env once approved:
#   TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8787/api/auth/tiktok/callback
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# ——— Phase 4: Instagram ———
# developers.facebook.com → Create app → use case
#   "Instagram API with Instagram Login" → add your Professional account
#   under Instagram Testers → Basic settings → copy App ID / Secret
# Redirect URI: http://localhost:8787/api/auth/instagram/callback
# NOTE: Development mode is testers-only until Meta reviews the app.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8787/api/auth/instagram/callback

# ——— Phase 3: YouTube ———
# console.cloud.google.com → Create project → APIs & Services →
#   enable "YouTube Data API v3" → OAuth consent screen (External, Testing
#   mode, add yourself as a test user) → Credentials → Create OAuth client ID
#   (Web application) → redirect URI:
#   http://localhost:8787/api/auth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/youtube/callback

# ——— Phase 2: LinkedIn ———
# developer.linkedin.com → Create app → add products:
#   "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn"
# Auth tab → Redirect URL:
#   http://localhost:8787/api/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8787/api/auth/linkedin/callback
