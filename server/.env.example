# MongoDB — Atlas M0 (free) or a local instance.
# Atlas: create an M0 cluster → database user → allow your IP → paste the string.
MONGODB_URI=mongodb://127.0.0.1:27017/pulse

# Generate once:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Server refuses to boot without it — never commit the real value.
JWT_SECRET=replace-me

# Local API port
PORT=8787

# Frontend origin allowed to call the API with cookies (no trailing slash).
CLIENT_ORIGIN=http://localhost:5173
